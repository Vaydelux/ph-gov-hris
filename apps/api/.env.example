# ── Government HRIS API — environment template ─────────────────────────────
# Copy to .env and fill real values. Production mode refuses to start without
# the required variables (fail-fast in src/config.ts).

# preview | production — preview tolerates absent credentials; production fails fast
APP_MODE=preview
PORT=4000
# Public URL of the web app (CORS allowlist)
APPLICATION_URL=http://localhost:5173

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Supabase → Settings → Database → Connection string (pooler or direct)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection used ONLY by `prisma migrate` (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# ── Supabase Auth & Storage ────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
# Server-side only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Settings → API → JWT secret (used to verify access tokens)
SUPABASE_JWT_SECRET=
# Private storage buckets (created via Storage UI or migration)
STORAGE_BUCKET_REPORTS=hris-reports
STORAGE_BUCKET_DOCUMENTS=hris-documents

# ── BullMQ / Upstash Redis ─────────────────────────────────────────────────
# Upstash Console → Redis → REST API; BullMQ uses the rediss:// connection
REDIS_URL="rediss://default:[password]@[endpoint].upstash.io:6379"
UPSTASH_REDIS_REST_URL=https://[endpoint].upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Mail (worker sends via API; SMTP example) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Government HRIS <no-reply@dcs.gov.ph>"

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# production | staging | development — seed refuses to run in production
APP_ENV=development
