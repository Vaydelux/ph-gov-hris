# Government HRIS API (NestJS) — copy to apps/api/.env
NODE_ENV=development
PORT=4000

# Supabase PostgreSQL. Use the DIRECT (session) URL for migrations, the
# pooler URL is fine for runtime.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres

# Supabase Auth verification (JWKS) + server-side storage access.
# The service-role key MUST never be exposed to the browser.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# BullMQ broker (Upstash Redis, rediss:// URL accepted by ioredis)
REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379

# Public URLs / CORS
APPLICATION_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional
SENTRY_DSN=
