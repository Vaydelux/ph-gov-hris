# ── Government HRIS worker ─────────────────────────────────────────────────
APP_MODE=preview
# Same PostgreSQL as the API (Supabase)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"
# Upstash Redis — must match the API's queue connection
REDIS_URL="rediss://default:[password]@[endpoint].upstash.io:6379"
# Private storage (worker uploads generated files here)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_REPORTS=hris-reports
# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Government HRIS <no-reply@dcs.gov.ph>"
# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
APP_ENV=development
