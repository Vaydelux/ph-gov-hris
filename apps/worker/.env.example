# Government HRIS worker (BullMQ) — copy to apps/worker/.env
NODE_ENV=development

DATABASE_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres

# Same Upstash Redis as the API — queues are shared by name.
REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379

# Private storage bucket "hris-private" (reports, payslips, CVs)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
SENTRY_DSN=
