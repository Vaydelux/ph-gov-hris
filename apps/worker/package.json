    "bullmq": "^5.12.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^6.9.14",
    "puppeteer": "^23.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
