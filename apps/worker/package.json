{
  "name": "@gov-hris/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Government HRIS background workers (BullMQ on Upstash Redis): payroll computation, payslips, PDF/Excel reports, bulk email, biometric imports.",
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gov-hris/contracts": "workspace:*",
    "@prisma/client": "^5.19.0",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.12.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.1",
    "puppeteer": "^23.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
