# ============================================================================
# Government HRIS — web app (apps/web) environment template.
# Copy to .env.local. Preview mode needs NOTHING else.
# ============================================================================

# preview  → in-browser adapter + fictional fixtures (src/server/*) — default
# production → typed REST client against the NestJS API; never falls back to
#              demo data; missing API config fails loudly
VITE_APP_MODE=preview

# Required when VITE_APP_MODE=production
VITE_API_URL=http://localhost:4000/api/v1

# Supabase (browser-safe values ONLY — the service-role key is API-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional monitoring
VITE_SENTRY_DSN=
